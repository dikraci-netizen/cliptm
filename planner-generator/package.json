    "generate:weekly": "node index.js --type weekly",
    "generate:monthly": "node index.js --type monthly",
    "generate:yearly": "node index.js --type yearly",
    "generate:budget": "node index.js --type budget",
    "generate:fitness": "node index.js --type fitness",
    "generate:meal": "node index.js --type meal",
    "generate:project": "node index.js --type project",
    "generate:habit": "node index.js --type habit",
    "generate:goal": "node index.js --type goal",
    "generate:student": "node index.js --type student",
