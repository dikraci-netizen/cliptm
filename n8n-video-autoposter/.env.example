# =====================================================================
# ClipTM - .env.example
# Copy this file to .env and fill in your values.
# All services listed here are FREE-tier compatible.
# =====================================================================

# ---- n8n auth & encryption ----
# Generate a 32-char random string: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace_with_random_32_char_string
N8N_USER=admin
N8N_PASSWORD=changeme_strong_password
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
TZ=Europe/Paris

# ---- Default video settings (can also be set per-run in the UI) ----
VIDEO_NICHE=productivity
VIDEO_KEYWORD=morning routine
VIDEO_LANGUAGE=fr
VIDEO_DURATION=45
# French voices: fr-FR-DeniseNeural, fr-FR-HenriNeural, fr-FR-VivienneMultilingualNeural
# English voices: en-US-AriaNeural, en-US-GuyNeural, en-GB-SoniaNeural
VIDEO_VOICE=fr-FR-DeniseNeural

# ---- Groq API (FREE - https://console.groq.com) ----
# Configure in n8n credentials as "Groq API"
# Header name: Authorization   Header value: Bearer gsk_xxx

# ---- Facebook Page ----
FB_PAGE_ID=
# Page Access Token configured as n8n credential "Facebook Page Token"

# ---- Instagram (Graph API - via Facebook) ----
IG_USER_ID=

# ---- LinkedIn ----
# Format: urn:li:person:XXXXXXXX
LINKEDIN_PERSON_URN=

# ---- TikTok ----
# OAuth bearer token configured as n8n credential "TikTok OAuth Bearer"

# ---- X (Twitter) ----
# OAuth1 credentials configured in n8n

# ---- Public video hosting (REQUIRED for IG/TikTok PULL_FROM_URL) ----
# Easiest free option: Cloudflare R2 public bucket, GitHub Releases, or Catbox.moe
# This is the base URL where your final mp4 files are reachable.
PUBLIC_VIDEO_URL_BASE=https://your-cdn.example.com/videos

# ---- Google Sheets logging ----
SHEET_ID=

# ---- Telegram notifications (FREE) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
